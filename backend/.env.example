# ────────────────────────────────────────────────────────────────────────────
# Project 360 — Backend Environment Variables
# Copy this file to .env and fill in your values before running the server.
# NEVER commit .env to source control.
# ────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── App URL (used in all email links — must match the deployed frontend URL) ─
APP_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/project360_dev
MONGODB_TEST_URI=mongodb://localhost:27017/project360_test

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d

# ── Email / SMTP ──────────────────────────────────────────────────────────────
#
# DEVELOPMENT (default):
#   Leave EMAIL_HOST, EMAIL_USER, EMAIL_PASSWORD blank.
#   The server will automatically use Ethereal (https://ethereal.email).
#   Emails are captured — not really sent. A preview URL is logged to the console.
#
# PRODUCTION — SendGrid (recommended):
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=apikey
#   EMAIL_PASSWORD=SG.your_sendgrid_api_key
#   EMAIL_FROM="Project 360" <noreply@project360.co.za>
#
# PRODUCTION — Gmail (app password required, not your main password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=your.account@gmail.com
#   EMAIL_PASSWORD=your_16_char_app_password
#   EMAIL_FROM="Project 360" <your.account@gmail.com>
#
# PRODUCTION — Custom SMTP (e.g. Mailgun, AWS SES SMTP):
#   EMAIL_HOST=smtp.mailgun.org
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=postmaster@mg.yourdomain.co.za
#   EMAIL_PASSWORD=your_mailgun_smtp_password
#   EMAIL_FROM="Project 360" <noreply@yourdomain.co.za>

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Project 360" <noreply@project360.co.za>

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Storage (AWS S3) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_S3_BUCKET=

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
